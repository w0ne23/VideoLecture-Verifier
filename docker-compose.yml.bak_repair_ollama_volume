services:
  db:
    image: postgres:16
    extra_hosts:
      - "host.docker.internal:host-gateway"

    environment:
      POSTGRES_DB: verilec
      POSTGRES_USER: user
      POSTGRES_PASSWORD: pass
      # LocalVLM / OpenAI-compatible DiffusionGemma

    ports:
      - "5433:5432"
    volumes:
      ollama:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U user -d verilec"]
      interval: 5s
      timeout: 5s
      retries: 10

  backend:
    build:
      context: .
      dockerfile: backend/Dockerfile

    env_file:
      - .env

    environment:
      DATABASE_URL: postgresql+asyncpg://user:pass@db/verilec
      LOCAL_STORAGE_DIR: /app/storage
      PIPELINE_ROOT: /app
      # LocalVLM / ollama
      GRAPHLEC_VLM_ENABLED: "1"
      GRAPHLEC_VLM_APPLY: "1"
      GRAPHLEC_VLM_PROVIDER: "ollama"
      GRAPHLEC_OLLAMA_BASE_URL: "http://ollama:11434"
      GRAPHLEC_OLLAMA_MODEL: "qwen3.5:9b"
      GRAPHLEC_VLM_WORKERS: "1"
      GRAPHLEC_VLM_BATCH_IMAGES: "2"
      GRAPHLEC_VLM_BATCH_CANDIDATES: "1"
      GRAPHLEC_VLM_TIMELINE_CONTEXT_IMAGES: "0"
      GRAPHLEC_VLM_TIMEOUT_SEC: "300"
      GRAPHLEC_VLM_NUM_PREDICT: "128"
      GRAPHLEC_VLM_IMAGE_WIDTH: "768"

      # GPU 1번만 컨테이너에 노출
      NVIDIA_VISIBLE_DEVICES: "1"
      NVIDIA_DRIVER_CAPABILITIES: "compute,utility,video"

      # VeriLec / GraphLec GPU decode 설정
      GRAPHLEC_SLIDE_DECODE_BACKEND: ffmpeg-cuda
      GRAPHLEC_GPU_ONLY: "0"

      # Ultralytics / matplotlib 경고 방지용
      YOLO_CONFIG_DIR: /tmp/Ultralytics
      MPLCONFIGDIR: /tmp/matplotlib

      # Step 0 sample cache chunk 병렬화
      GRAPHLEC_SAMPLE_CACHE_CHUNK_WORKERS: "12"
      GRAPHLEC_SAMPLE_CACHE_CHUNK_SEC: "300"
      GRAPHLEC_SAMPLE_CACHE_CHUNK_OVERLAP_SEC: "30"
      GRAPHLEC_SAMPLE_CACHE_MERGE_WORKERS: "6"
      GRAPHLEC_SAMPLE_CACHE_MERGE_MASK_WORKERS: "12"

      # Step 1 timeline region 병렬화
      GRAPHLEC_REGION_WORKERS: "12"
      GRAPHLEC_REGION_CHUNK_SAMPLES: "2000"
      GRAPHLEC_REGION_GUARD_SAMPLES: "1"

      # Step 2 scene/base probe 병렬화
      GRAPHLEC_SCENE_PROBE_WORKERS: "12"
      GRAPHLEC_SCENE_PROBE_CHUNK_SAMPLES: "2000"
      GRAPHLEC_SCENE_PROBE_GUARD_SAMPLES: "100"
      GRAPHLEC_SCENE_PROBE_KEEP_PARTS: "0"

      # Step 4 duplicates 병렬화
      GRAPHLEC_DUPLICATE_PARALLEL: "1"
      GRAPHLEC_DUPLICATE_WORKERS: "12"
      GRAPHLEC_DUPLICATE_LOG_PAIRS: "0"

    volumes:
      - ./storage:/app/storage
      - ./input:/app/input

    ports:
      - "8003:8000"

    depends_on:
      db:
        condition: service_healthy

    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              device_ids: ["1"]
              capabilities: [gpu]



  ollama:
    profiles:
      - vlm
    image: ollama/ollama:latest
    container_name: verilec-ollama
    environment:
      NVIDIA_VISIBLE_DEVICES: "1"
      NVIDIA_DRIVER_CAPABILITIES: "compute,utility"
    volumes:
      - ollama:/root/.ollama
    ports:
      - "11434:11434"
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              device_ids: ["1"]
              capabilities: [gpu]

volumes:
  postgres_data: