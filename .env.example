ISSUE_TYPE_CLASSIFIER_BATCH_RETRIES=2
ISSUE_TYPE_CLASSIFIER_BATCH_RETRY_WAIT_SEC=0
ISSUE_TYPE_CLASSIFIER_RETRY_WAIT_SEC=0
