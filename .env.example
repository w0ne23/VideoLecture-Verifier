# =============================================================================
# LLM API 키 (필수: Gemini + Groq)
# =============================================================================
# Gemini — 슬라이드 텍스트화/필기 분석(키 1), 텍스트 교정/그룹핑(키 2, 없으면 키 1 재사용)
GOOGLE_API_KEY_1=
GOOGLE_API_KEY_2=
# Groq — Whisper 전체 전사
GROQ_API_KEY=

# 멀티 LLM 검증용 (ISSUE_JUDGE_MODELS에 지정한 모델의 키만 있으면 됨)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=

# =============================================================================
# 검증 파이프라인 설정
# =============================================================================
VERIFIER_VERSION=4
ISSUE_JUDGE_MODELS=gpt-5.4, claude-sonnet-4.5
ISSUE_JUDGE_MAX_WORKERS=6
VERIFIER_MODEL=gemini-2.5-flash
VERIFIER_SLIDE_ERROR_MODEL=gemini-2.5-flash
VERIFIER_CLAIM_EXTRACT_MODEL=gemini-2.5-flash
VERIFIER_CLAIM_JUDGE_MODEL=gemini-2.5-flash

# =============================================================================
# PostgreSQL
# =============================================================================
POSTGRES_DB=verilec
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
# 로컬 개발(docker compose db가 5433으로 노출됨):
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5433/verilec
# Docker 컨테이너 안에서 실행할 때는 compose가 @db 주소로 덮어씀

# =============================================================================
# 백엔드 / 런타임
# =============================================================================
PYTHONUNBUFFERED=1
# 동시 처리 워커 수 (기본 1)
VERILEC_BACKEND_WORKERS=1

# =============================================================================
# 전처리 튜닝 (선택)
# =============================================================================
# 슬라이드 프레임 디코드 백엔드: auto | opencv | ffmpeg-cuda | ffmpeg-videotoolbox
VERILEC_SLIDE_DECODE_BACKEND=auto
# 필기(주석) 분석 병렬 워커 수. 0 = 자동
VERILEC_ANNOT_WORKERS=0

# =============================================================================
# 로컬 VLM / 슬라이드 시각 분석 (선택, 기본 비활성)
# =============================================================================
VERILEC_VLM_ENABLED=0
VERILEC_VLM_PROVIDER=ollama
VERILEC_OLLAMA_MODEL=gemma3:4b
VERILEC_OLLAMA_BASE_URL=http://localhost:11434
VERILEC_VLM_WORKERS=2
VERILEC_VLM_TEMPERATURE=0.0
VERILEC_VLM_APPLY=0
VERILEC_VLM_APPLY_MIN_CONFIDENCE=0.65
