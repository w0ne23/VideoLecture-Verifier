GOOGLE_API_KEY_1=
GOOGLE_API_KEY_2=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_THINKING=disabled
DEEPSEEK_REASONING_EFFORT=
DEEPSEEK_TIMEOUT_SEC=180
VERIFIER_DEEPSEEK_TIMEOUT_SEC=180
VERIFIER_DEEPSEEK_API_MAX_RETRIES=4
VERIFIER_DEEPSEEK_API_INITIAL_WAIT=5
ISSUE_JUDGE_MODELS=gpt-5.4,claude-sonnet-4.5,grok-4
ISSUE_JUDGE_MODEL_WEIGHTS=gpt-5.4=0.4,claude-sonnet-4.5=0.4,grok-4=0.2
ISSUE_JUDGE_MAX_WORKERS=12
# GPT/Claude confidence delta >= this value drops the claim from merged issues
# (unless either side is >= KEEP_CONFIDENCE). Set to 1.0 to effectively disable.
VERIFIER_ISSUE_JUDGE_DISAGREEMENT_REJECT_DELTA=0.40
VERIFIER_ISSUE_JUDGE_DISAGREEMENT_KEEP_CONFIDENCE=0.90
VERIFIER_STAGE_MAX_WORKERS=12
VERIFIER_SLIDE_ERROR_MODEL=gpt-4.1-mini
ANNOTATION_VLM_MODEL=gpt-4.1-mini
VERIFIER_CLAIM_EXTRACT_BATCH_SIZE=2
VERIFIER_CLAIM_EXTRACT_MAX_WORKERS=12
VERIFIER_CLAIM_EXTRACT_PROMPT_PROFILE=auto
ISSUE_TYPE_CLASSIFIER_BATCH_SIZE=10
ISSUE_TYPE_CLASSIFIER_MAX_WORKERS=12
CLASSIFIED_ISSUE_VERIFIER_MAX_WORKERS=12
CLASSIFIED_ISSUE_GROUNDING_MAX_WORKERS=12
CLASSIFIED_SLIDE_ERROR_MAX_WORKERS=12
ISSUE_TYPE_CLASSIFIER_API_RETRY_WAIT_SEC=10
ISSUE_TYPE_CLASSIFIER_BATCH_RETRIES=2
ISSUE_TYPE_CLASSIFIER_BATCH_RETRY_WAIT_SEC=10
ISSUE_TYPE_CLASSIFIER_GROK_RETRY_WAIT_SEC=60
TRANSCRIBE_SILENCE_SPLIT_SEC=1.5
TRANSCRIBE_CHUNK_MAX_SEC=180
TRANSCRIBE_CHUNK_MIN_SEC=30

POSTGRES_DB=graphlec
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
DATABASE_URL=postgresql+asyncpg://user:pass@db/graphlec

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

PYTHONUNBUFFERED=1

GRAPHLEC_BACKEND_WORKERS=3
GRAPHLEC_WORKER_PIN_CPUS=1
# Optional explicit CPU groups per backend worker, separated by semicolons.
# Empty means split available CPUs evenly, e.g. 128 threads -> 0-42 / 43-85 / 86-127.
GRAPHLEC_WORKER_CPU_SETS=

GRAPHLEC_AUDIO_TEMPO_ENABLED=1
GRAPHLEC_TEXT_PROCESSOR_API_MAX_RETRIES=0
GRAPHLEC_API_RETRY_MAX_WAIT_SEC=60
GRAPHLEC_SLIDE_TEXTUALIZER_PROVIDER=openai
GRAPHLEC_SLIDE_TEXTUALIZER_MODEL=gpt-5.4-mini
GRAPHLEC_SLIDE_TEXTUALIZER_WORKERS=12
GRAPHLEC_SLIDE_OCR_PROVIDER=http
GRAPHLEC_SLIDE_OCR_BASE_URL=http://127.0.0.1:8000
GRAPHLEC_SLIDE_OCR_LANG=multilingual
GRAPHLEC_SLIDE_OCR_MODEL_DIR=
GRAPHLEC_SLIDE_OCR_TIMEOUT_SEC=300
GRAPHLEC_SLIDE_OCR_SIMILARITY_THRESHOLD=0.83
GRAPHLEC_SLIDE_OCR_ADJACENT_SIMILARITY_THRESHOLD=0.83
GRAPHLEC_SAMPLE_CACHE_PERSON_MASKS=1
GRAPHLEC_SAMPLE_CACHE_PERSON_MASK_CONF=0.70
GRAPHLEC_SAMPLE_CACHE_PERSON_MASK_MIN_BBOX_HEIGHT_RATIO=0.08
GRAPHLEC_SAMPLE_CACHE_PERSON_MASK_MAX_BBOX_ASPECT=1.50
GRAPHLEC_SAMPLE_CACHE_PERSON_MASK_FIXED_MOTION_MIN_MEAN_DIFF=2.0
GRAPHLEC_SAMPLE_CACHE_PERSON_MASK_FIXED_MOTION_MIN_CHANGED_RATIO=0.01
GRAPHLEC_SAMPLE_CACHE_PERSON_MASK_FIXED_MIN_CENTER_SHIFT_PX=4
GRAPHLEC_SAMPLE_CACHE_PERSON_MASK_FIXED_MIN_AREA_CHANGE_RATIO=0.08
GRAPHLEC_SAMPLE_CACHE_PERSON_GATE_INTERVAL_SEC=20
GRAPHLEC_SAMPLE_CACHE_PERSON_GATE_MIN_HITS=1
GRAPHLEC_SAMPLE_CACHE_PERSON_GATE_CONF=0.45
GRAPHLEC_SCENE_BASE_DELAY_SEC=2.0
GRAPHLEC_SCENE_BASE_MAX_PENDING_SEC=5.0
GRAPHLEC_CONTENT_CROP_LEFT=0.05
GRAPHLEC_CONTENT_CROP_TOP=0.05
GRAPHLEC_CONTENT_CROP_RIGHT=0.95
GRAPHLEC_CONTENT_CROP_BOTTOM=0.95
GRAPHLEC_DUPLICATE_WORKERS=24
GRAPHLEC_SAMPLE_CACHE_PERSON_GATE_WIDTH=384
GRAPHLEC_SAMPLE_CACHE_STORAGE_MODE=auto
VERILEC_SHM_SIZE=64g
GRAPHLEC_SAMPLE_CACHE_PERSON_MASK_MODEL=/app/models/yolo26n.pt
GRAPHLEC_SAMPLE_CACHE_PERSON_MASK_ENGINE=/app/storage/models/yolo26n-fp16.engine
GRAPHLEC_SAMPLE_CACHE_PERSON_MASK_WORKERS=4
GRAPHLEC_SAMPLE_CACHE_PERSON_MASK_TASK_SEC=480
GRAPHLEC_SAMPLE_CACHE_PERSON_MASK_TASK_OVERLAP_SEC=5
GRAPHLEC_SAMPLE_CACHE_PERSON_MASK_ENGINE_BATCH_SIZE=32
GRAPHLEC_TEXT_PROCESSOR_IMAGE_PROVIDER=openai
GRAPHLEC_TEXT_PROCESSOR_IMAGE_MODEL=gpt-4.1-mini
QUERY_SERVICE_LLM_PROVIDER=gemini
QUERY_SERVICE_OPENAI_MODEL=gpt-5.4
RECOMMENDER_LLM_PROVIDER=openai
RECOMMENDER_OPENAI_MODEL=gpt-5.4

# Staged slide extraction.
# 0 means auto: conservative parallelism for scene-level annotation detection.
GRAPHLEC_ANNOT_WORKERS=16
GRAPHLEC_GRAPHRAG_CONCURRENT_REQUESTS=50
GRAPHLEC_GRAPHRAG_INDEX_RETRIES=1
GRAPHLEC_GRAPHRAG_INDEX_RETRY_WAIT_SEC=30

GRAPHLEC_VLM_ENABLED=0
GRAPHLEC_VLM_PROVIDER=ollama
GRAPHLEC_OPENAI_BASE_URL=https://api.openai.com/v1
GRAPHLEC_OPENAI_API_KEY=${OPENAI_API_KEY}
GRAPHLEC_OPENAI_MODEL=gpt-5.4-mini
GRAPHLEC_OLLAMA_MODEL=qwen3.5:9b
GRAPHLEC_OLLAMA_BASE_URL=http://host.docker.internal:11434
# CPU/local: 2, GPU server: 4
GRAPHLEC_VLM_WORKERS=3
GRAPHLEC_VLM_TEMPERATURE=0.0
GRAPHLEC_VLM_TIMEOUT_SEC=180
GRAPHLEC_VLM_NUM_PREDICT=512
GRAPHLEC_VLM_IMAGE_WIDTH=768
GRAPHLEC_VLM_BATCH_IMAGES=10
GRAPHLEC_VLM_BATCH_OVERLAP_IMAGES=0
GRAPHLEC_VLM_BATCH_CANDIDATES=5
GRAPHLEC_VLM_APPLY=0
GRAPHLEC_VLM_APPLY_MIN_CONFIDENCE=0.65
