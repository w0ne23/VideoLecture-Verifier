GOOGLE_API_KEY_1=
GOOGLE_API_KEY_2=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_THINKING=disabled
DEEPSEEK_REASONING_EFFORT=
DEEPSEEK_TIMEOUT_SEC=180
VERIFIER_DEEPSEEK_TIMEOUT_SEC=180
VERIFIER_DEEPSEEK_API_MAX_RETRIES=4
VERIFIER_DEEPSEEK_API_INITIAL_WAIT=5
ISSUE_JUDGE_MODELS=gpt-5.4,claude-sonnet-4.5,grok-4
ISSUE_JUDGE_MODEL_WEIGHTS=gpt-5.4=0.4,claude-sonnet-4.5=0.4,grok-4=0.2
ISSUE_JUDGE_MAX_WORKERS=6
VERIFIER_SLIDE_ERROR_MODEL=gpt-4.1-mini
ANNOTATION_VLM_MODEL=gpt-4.1-mini
VERIFIER_CLAIM_EXTRACT_BATCH_SIZE=2
VERIFIER_CLAIM_EXTRACT_MAX_WORKERS=4
VERIFIER_CLAIM_EXTRACT_PROMPT_PROFILE=auto
ISSUE_TYPE_CLASSIFIER_BATCH_SIZE=10
ISSUE_TYPE_CLASSIFIER_MAX_WORKERS=1
ISSUE_TYPE_CLASSIFIER_API_RETRY_WAIT_SEC=10
ISSUE_TYPE_CLASSIFIER_BATCH_RETRIES=2
ISSUE_TYPE_CLASSIFIER_BATCH_RETRY_WAIT_SEC=10
ISSUE_TYPE_CLASSIFIER_GROK_RETRY_WAIT_SEC=60
TRANSCRIBE_SILENCE_SPLIT_SEC=1.5
TRANSCRIBE_CHUNK_MAX_SEC=180
TRANSCRIBE_CHUNK_MIN_SEC=30

POSTGRES_DB=graphlec
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
DATABASE_URL=postgresql+asyncpg://user:pass@db/graphlec

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

PYTHONUNBUFFERED=1

GRAPHLEC_BACKEND_WORKERS=3
GRAPHLEC_WORKER_PIN_CPUS=1
# Optional explicit CPU groups per backend worker, separated by semicolons.
# Empty means split available CPUs evenly, e.g. 128 threads -> 0-42 / 43-85 / 86-127.
GRAPHLEC_WORKER_CPU_SETS=

GRAPHLEC_AUDIO_TEMPO_ENABLED=1
GRAPHLEC_TEXT_PROCESSOR_API_MAX_RETRIES=0
GRAPHLEC_API_RETRY_MAX_WAIT_SEC=60
GRAPHLEC_SLIDE_TEXTUALIZER_PROVIDER=openai
GRAPHLEC_SLIDE_TEXTUALIZER_MODEL=gpt-4.1-mini
GRAPHLEC_TEXT_PROCESSOR_IMAGE_PROVIDER=openai
GRAPHLEC_TEXT_PROCESSOR_IMAGE_MODEL=gpt-4.1-mini
QUERY_SERVICE_LLM_PROVIDER=gemini
QUERY_SERVICE_OPENAI_MODEL=gpt-5.4
RECOMMENDER_LLM_PROVIDER=openai
RECOMMENDER_OPENAI_MODEL=gpt-5.4

# Staged slide extraction.
# 0 means auto: conservative parallelism for scene-level annotation detection.
GRAPHLEC_ANNOT_WORKERS=16
GRAPHLEC_GRAPHRAG_CONCURRENT_REQUESTS=50
GRAPHLEC_GRAPHRAG_INDEX_RETRIES=1
GRAPHLEC_GRAPHRAG_INDEX_RETRY_WAIT_SEC=30

GRAPHLEC_VLM_ENABLED=0
GRAPHLEC_VLM_PROVIDER=ollama
GRAPHLEC_OLLAMA_MODEL=qwen2.5vl:7b
GRAPHLEC_OLLAMA_BASE_URL=http://host.docker.internal:11434
# CPU/local: 2, GPU server: 4
GRAPHLEC_VLM_WORKERS=3
GRAPHLEC_VLM_TEMPERATURE=0.0
GRAPHLEC_VLM_TIMEOUT_SEC=180
GRAPHLEC_VLM_NUM_PREDICT=1024
GRAPHLEC_VLM_IMAGE_WIDTH=768
GRAPHLEC_VLM_BATCH_IMAGES=10
GRAPHLEC_VLM_BATCH_OVERLAP_IMAGES=0
GRAPHLEC_VLM_BATCH_CANDIDATES=5
GRAPHLEC_VLM_APPLY=0
GRAPHLEC_VLM_APPLY_MIN_CONFIDENCE=0.65
