CLASSIFIED_ISSUE_EVIDENCE_VERIFY_MAX_SOURCES=3
CLASSIFIED_ISSUE_EVIDENCE_MAX_FETCH_ATTEMPTS=10
CLASSIFIED_ISSUE_EVIDENCE_SEMANTIC_MAX_TOKENS=800
CLASSIFIED_ISSUE_EVIDENCE_SEMANTIC_MIN_CONFIDENCE=0.75
CLASSIFIED_ISSUE_GROUNDING_MAX_WORKERS=20
CLASSIFIED_SLIDE_ERROR_MAX_WORKERS=20
