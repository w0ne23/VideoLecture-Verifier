GOOGLE_API_KEY_1=
GOOGLE_API_KEY_2=
GROQ_API_KEY=
OPENAI_API_KEY=
# LiteLLM proxy runtime settings.
LITELLM_ENABLED=1
LITELLM_BASE_URL=http://litellm:4000/v1
LITELLM_API_KEY=sk-vlverifier-local-dev
LITELLM_MASTER_KEY=sk-vlverifier-local-dev
LITELLM_DATABASE_URL=postgresql://user:pass@db/litellm
# Fernet-compatible key or any stable secret. Used only to encrypt API keys
# entered through the web UI. Set a unique value in deployments.
VLVERIFIER_CREDENTIAL_ENCRYPTION_KEY=
LITELLM_PORT=4000
LITELLM_MODEL_CATALOG_URL=https://api.litellm.ai/model_catalog
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
XAI_API_KEY=
# OpenAI-compatible local/remote vLLM endpoint.
LOCAL_LLM_API_KEY=
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=qwen3.8-27b
LOCAL_LLM_ENABLE_THINKING=0
# Backward-compatible aliases.
VLLM_API_KEY=
VLLM_BASE_URL=
VLLM_MODEL=qwen3.6-35b-a3b
VLLM_ENABLE_THINKING=0
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_THINKING=disabled
DEEPSEEK_REASONING_EFFORT=
DEEPSEEK_TIMEOUT_SEC=180
VERIFIER_DEEPSEEK_TIMEOUT_SEC=180
VERIFIER_DEEPSEEK_API_MAX_RETRIES=4
VERIFIER_DEEPSEEK_API_INITIAL_WAIT=0
VERIFIER_API_INITIAL_WAIT=0
# Detector, classifier, verifier 모델은 웹 UI의 단계별 LiteLLM 바인딩에서 선택합니다.
ISSUE_JUDGE_MAX_WORKERS=20
VERIFIER_ISSUE_JUDGE_BATCH_MAX_WORKERS=20
# 모든 Detector 모델에 공통 적용되는 이슈 동의 기준
VERIFIER_ISSUE_JUDGE_MIN_CONFIDENCE=0.70
# 절반 이상 합의에 못 미쳐도 단일 모델이 이 점수 이상이면 후보로 통과
VERIFIER_ISSUE_JUDGE_SINGLE_MODEL_KEEP_CONFIDENCE=0.85
VERIFIER_ISSUE_JUDGE_PROMPT_LAYOUT=legacy
VERIFIER_STAGE_MAX_WORKERS=20
ANNOTATION_VLM_MODEL=gpt-4.1-mini
VERIFIER_CLAIM_EXTRACT_BATCH_SIZE=2
VERIFIER_CLAIM_EXTRACT_MAX_WORKERS=20
VERIFIER_CLAIM_EXTRACT_PROMPT_PROFILE=auto
ISSUE_TYPE_CLASSIFIER_BATCH_SIZE=10
ISSUE_TYPE_CLASSIFIER_MAX_WORKERS=20
CLASSIFIED_ISSUE_VERIFIER_MAX_WORKERS=20
CLASSIFIED_ISSUE_EVIDENCE_ENABLED=1
CLASSIFIED_ISSUE_EVIDENCE_MAX_WORKERS=20
CLASSIFIED_ISSUE_EVIDENCE_MAX_TOKENS=600
CLASSIFIED_ISSUE_EVIDENCE_QUERY_PLAN_MAX_TOKENS=1200
CLASSIFIED_ISSUE_EVIDENCE_MAX_TOOL_CALLS=1
CLASSIFIED_ISSUE_EVIDENCE_SEARCH_CONTEXT_SIZE=medium
